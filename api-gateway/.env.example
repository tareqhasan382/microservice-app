NODE_ENV=development
PORT=5000
JWT_ACCESS_SECRET=your_access_secret_here

USER_SERVICE_BASE=http://user-service:5001
TASK_SERVICE_BASE=http://task-service:5002
NOTIFICATION_SERVICE_BASE=http://notification-service:5003

REDIS_URL=redis://redis:6379

AUTH_JWT_SECRET=replace_with_a_long_random_secret
GATEWAY_JWT_SECRET=replace_with_a_long_random_secret
GATEWAY_JWT_EXPIRES_IN=1m

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

DEFAULT_TIMEOUT=30000

LOG_LEVEL=debug
